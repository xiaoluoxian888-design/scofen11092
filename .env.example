# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend API Key for live transactional email dispatch.
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxx
# If unset or in sandbox mode, email dispatches are simulated safely without crashing.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Verified sender email address.
# Use 'Scofen <onboarding@resend.dev>' for free testing on unverified domains,
# or 'Scofen <notifications@scofen.com>' once your custom domain DNS is verified in Resend.
RESEND_FROM_EMAIL="Scofen <onboarding@resend.dev>"

# ADMIN_ALERT_EMAIL: Protocol administrator address for Stripe disputes and system alerts.
ADMIN_ALERT_EMAIL="admin@scofen.com"

# STRIPE_SECRET_KEY: Stripe Secret Key for payment processing (sk_test_... or sk_live_...).
STRIPE_SECRET_KEY=""

# STRIPE_PUBLISHABLE_KEY: Stripe Publishable Key for client-side checkout (pk_test_... or pk_live_...).
STRIPE_PUBLISHABLE_KEY=""

# STRIPE_WEBHOOK_SECRET: Stripe Webhook Signing Secret (whsec_...).
STRIPE_WEBHOOK_SECRET=""
